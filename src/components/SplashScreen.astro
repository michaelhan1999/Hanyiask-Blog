---
// Splash Screen v4 — 抽象 Logo + 呼吸动画
// 概念：一个渐变紫色方形悬浮在黑暗中，缓慢呼吸缩放，光影流动
---

<div id="splash">
  <div class="splash-bg"></div>

  <!-- 中心 Logo -->
  <div class="splash-logo-wrap" id="splash-logo">
    <!-- 底座光晕 -->
    <div class="logo-glow"></div>
    <!-- 主 Logo -->
    <div class="logo-mark">
      <!-- 内部网格点阵 -->
      <div class="logo-grid"></div>
      <!-- Logo 主体：两个重叠的方形 -->
      <div class="logo-square logo-square-1"></div>
      <div class="logo-square logo-square-2"></div>
    </div>
  </div>

  <!-- 品牌名 -->
  <div class="splash-brand" id="splash-brand">
    <div class="splash-name-text">HANYIASK</div>
    <div class="splash-name-line"></div>
    <div class="splash-name-sub">AI Product Manager</div>
  </div>
</div>

<style>
  #splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #05050a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }

  .splash-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 45%, rgba(139,92,246,0.12) 0%, transparent 70%);
  }

  /* Logo 容器 */
  .splash-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
  }

  .logo-glow {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139,92,246,0.35) 0%, transparent 70%);
    filter: blur(20px);
    animation: glowPulse 3s ease-in-out infinite;
  }

  .logo-mark {
    position: relative;
    width: 64px;
    height: 64px;
    animation: breathe 3s ease-in-out infinite;
  }

  .logo-square {
    position: absolute;
    border-radius: 10px;
  }

  .logo-square-1 {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);
    box-shadow: 0 0 30px rgba(139,92,246,0.4), 0 0 60px rgba(139,92,246,0.15);
  }

  .logo-square-2 {
    width: 32px;
    height: 32px;
    top: 8px;
    left: 8px;
    background: rgba(167,139,250,0.25);
    border: 1px solid rgba(167,139,250,0.3);
  }

  /* 内部点阵 */
  .logo-grid {
    position: absolute;
    inset: 12px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 3px;
  }

  .logo-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(167,139,250,0.5) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  /* 品牌名 */
  .splash-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
  }

  .splash-name-text {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: #e5e5e5;
    padding-left: 0.4em;
  }

  .splash-name-line {
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #8B5CF6, transparent);
  }

  .splash-name-sub {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: #64748b;
    text-transform: uppercase;
  }

  /* 动画 */
  @keyframes breathe {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.06); opacity: 0.9; }
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.15); }
  }
</style>

<script>
  const splash = document.getElementById('splash')!;
  const logoWrap = document.getElementById('splash-logo')!;
  const brand = document.getElementById('splash-brand')!;

  if (!sessionStorage.getItem('splashV4')) {
    // 0ms: logo appears
    logoWrap.style.transition = 'opacity 0.7s ease';
    logoWrap.style.opacity = '1';

    // 600ms: brand name appears
    brand.style.transition = 'opacity 0.6s ease';
    setTimeout(() => { brand.style.opacity = '1'; }, 600);

    // 2400ms: all fades
    setTimeout(() => {
      splash.style.transition = 'opacity 0.6s ease';
      splash.style.opacity = '0';
    }, 2400);

    // 3000ms: done
    setTimeout(() => {
      splash.style.display = 'none';
      document.body.style.overflow = '';
      sessionStorage.setItem('splashV4', '1');
    }, 3000);
  } else {
    splash.style.display = 'none';
    document.body.style.overflow = '';
  }
</script>
