---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Han Zhengxin" description="AI Product Manager, exploring the intersection of technology and product." lang="en">
  <div class="page-container">

    <div style="margin-bottom: 48px;" class="animate-fade-up">
      <a href="/en/" style="font-size: 12px; color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: color 0.15s;">
        ← Back to Home
      </a>
    </div>

    <!-- Header -->
    <header style="display: flex; align-items: center; gap: 20px; margin-bottom: 48px;" class="animate-fade-up delay-100">
      <div style="width: 72px; height: 72px; border-radius: 16px; background: linear-gradient(135deg, rgba(139,92,246,0.3), rgba(109,40,217,0.3)); border: 1px solid rgba(139,92,246,0.2); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 700; color: var(--accent-light); box-shadow: 0 0 30px rgba(139,92,246,0.15); flex-shrink: 0; font-family: 'Noto Serif SC', serif;">
        韩
      </div>
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
          <h1 style="font-size: 24px; font-weight: 700; color: var(--text-primary);">Han Zhengxin</h1>
          <span style="font-size: 10px; color: var(--accent-light); border: 1px solid rgba(139,92,246,0.3); padding: 2px 8px; border-radius: 100px;">AI PM</span>
        </div>
        <p style="font-size: 13px; color: var(--text-muted);">Finding high-leverage paths to tech monetization at the intersection of AI and product.</p>
      </div>
    </header>

    <!-- Philosophy -->
    <section style="margin-bottom: 48px;" class="animate-fade-up delay-200">
      <h2 style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: 16px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
        <span style="width: 20px; height: 1px; background: var(--accent); opacity: 0.6; display: inline-block;"></span>
        Philosophy
      </h2>
      <div style="padding: 28px 32px; background: var(--bg-card); border: 1px solid var(--border); border-left: 2px solid var(--accent); border-radius: 0 10px 10px 0;">
        <p style="font-size: 16px; color: var(--text-secondary); line-height: 1.8; font-style: italic;">
          "The world is an improv stage where everyone is performing until they succeed.
          But while others are improvising, I'm building systems that don't crash."
        </p>
      </div>
    </section>

    <!-- Skills -->
    <section style="margin-bottom: 48px;" class="animate-fade-up delay-300">
      <h2 style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: 16px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
        <span style="width: 20px; height: 1px; background: var(--accent); opacity: 0.6; display: inline-block;"></span>
        Skills & Stack
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
        {[
          { cat: 'AI / Machine Learning', items: ['LLM & Prompt Engineering', 'RAG Systems', 'Model Fine-tuning', 'AI Product Strategy'] },
          { cat: 'Product Capabilities', items: ['PRD & Roadmap', 'User Research', 'Data-Driven Decisions', 'GTM Strategy'] },
          { cat: 'Engineering', items: ['TypeScript / Python', 'Cloudflare Workers', 'Docker & CI/CD', 'PostgreSQL'] },
        ].map(g => (
          <div style="padding: 20px 24px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px;">
            <p style="font-size: 11px; font-weight: 600; color: var(--accent-light); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.1em;">{g.cat}</p>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px;">
              {g.items.map(item => (
                <li style="font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 8px;">
                  <span style="width: 4px; height: 4px; border-radius: 50%; background: var(--accent); opacity: 0.5; flex-shrink: 0;"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section style="margin-bottom: 48px;" class="animate-fade-up delay-400">
      <h2 style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: 16px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
        <span style="width: 20px; height: 1px; background: var(--accent); opacity: 0.6; display: inline-block;"></span>
        Featured Projects
      </h2>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="padding: 24px 28px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px;">
          <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px;">
            <h3 style="font-size: 15px; font-weight: 600; color: var(--text-primary);">Han Zhengxin Blog</h3>
            <span class="post-tag">2026</span>
          </div>
          <p style="font-size: 13px; color: var(--text-muted); line-height: 1.7; margin-bottom: 14px;">
            This website. Zero hosting cost, lightning fast, built with Astro + TailwindCSS, deployed on Cloudflare Pages.
            Minimalist purple-dark theme showcasing AI product management thinking.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            {['Astro', 'TailwindCSS', 'Cloudflare Pages'].map(t => (
              <span style="font-size: 10px; color: var(--text-muted); border: 1px solid var(--border); padding: 2px 8px; border-radius: 4px;">{t}</span>
            ))}
          </div>
        </div>
        <div style="padding: 24px 28px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px;">
          <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px;">
            <h3 style="font-size: 15px; font-weight: 600; color: var(--text-primary);">ContentSafe</h3>
            <span class="post-tag">2025</span>
          </div>
          <p style="font-size: 13px; color: var(--text-muted); line-height: 1.7; margin-bottom: 14px;">
            Android offline reading app supporting Toutiao, WeChat public accounts, Weibo, Zhihu, and more.
            Built with Kotlin + Jetpack Compose.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            {['Kotlin', 'Jetpack Compose', 'Room', 'OkHttp'].map(t => (
              <span style="font-size: 10px; color: var(--text-muted); border: 1px solid var(--border); padding: 2px 8px; border-radius: 4px;">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="animate-fade-up delay-500">
      <h2 style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--text-muted); margin-bottom: 16px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
        <span style="width: 20px; height: 1px; background: var(--accent); opacity: 0.6; display: inline-block;"></span>
        Get in Touch
      </h2>
      <div style="padding: 28px 32px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
          <p style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px;">Open for Collaboration</p>
          <p style="font-size: 13px; color: var(--text-muted);">Let's talk about AI product ideas, project collaboration, or anything interesting.</p>
        </div>
        <a href="mailto:hi@hanyiask.com" class="btn btn-primary">hi@hanyiask.com</a>
      </div>
    </section>

  </div>
</BaseLayout>
