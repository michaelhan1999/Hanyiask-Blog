---
interface Props {
  color?: 'green' | 'purple';
  size?: number;
}

const { color = 'green', size = 5 } = Astro.props;
---

<span
  class="status-dot"
  style={`width: ${size}px; height: ${size}px; border-radius: 50%; background: ${color === 'green' ? '#10B981' : '#8B5CF6'}; box-shadow: 0 0 ${size * 2}px ${color === 'green' ? 'rgba(16,185,129,0.5)' : 'rgba(139,92,246,0.4)'}; animation: statusPulse ${color === 'green' ? '2.5' : '3'}s ease-in-out infinite; display: inline-block;`}
></span>

<style>
  @keyframes statusPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
