---
// Splash Screen v3 — 极致克制，一焦点，高级感
// 参考：Hashkey / Linear / Vercel 风格
---

<div id="splash">
  <div class="splash-inner">
    <!-- 品牌标记 -->
    <div class="splash-mark" id="splash-mark">
      <span class="splash-hanzi">韩</span>
    </div>

    <!-- 品牌名 -->
    <div class="splash-name" id="splash-name">
      <span>韩正新</span>
    </div>
  </div>
</div>

<style>
  #splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #05050a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* 品牌标记：纯文字，无背景，无边框，紫色字 */
  .splash-mark {
    opacity: 0;
    margin-bottom: 0;
  }

  .splash-hanzi {
    font-family: 'Noto Serif SC', serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: #a78bfa;
    letter-spacing: 0;
    line-height: 1;
    /* 微妙外发光 */
    text-shadow: 0 0 24px rgba(139, 92, 246, 0.25);
    display: block;
  }

  /* 品牌名：细体小字 */
  .splash-name {
    opacity: 0;
    margin-top: 10px;
    overflow: hidden;
  }

  .splash-name span {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.35em;
    color: #475569;
    text-transform: uppercase;
    padding-left: 0.35em; /* 补偿 letter-spacing */
  }
</style>

<script>
  const splash = document.getElementById('splash')!;
  const mark = document.getElementById('splash-mark')!;
  const name = document.getElementById('splash-name')!;

  if (!sessionStorage.getItem('splashShown_v3')) {
    // Timeline: 极度克制，只用 opacity 动画
    // 0ms: mark appears
    mark.style.transition = 'opacity 0.6s ease';
    mark.style.opacity = '1';

    // 400ms: name fades in
    name.style.transition = 'opacity 0.5s ease';
    setTimeout(() => { name.style.opacity = '1'; }, 400);

    // 1600ms: everything fades out together (短，不拖沓)
    setTimeout(() => {
      splash.style.transition = 'opacity 0.5s ease';
      splash.style.opacity = '0';
    }, 1600);

    // 2100ms: gone
    setTimeout(() => {
      splash.style.display = 'none';
      document.body.style.overflow = '';
      sessionStorage.setItem('splashShown_v3', '1');
    }, 2100);
  } else {
    splash.style.display = 'none';
    document.body.style.overflow = '';
  }
</script>
