---
// Language Switcher — 三语切换器 简中 / 繁中 / English
const currentPath = Astro.url.pathname;
const isTraditional = currentPath.startsWith('/tw');
const isEnglish = currentPath.startsWith('/en');
---

<div class="lang-switcher" id="lang-switcher">
  <button class="lang-btn" id="lang-btn" aria-label="Select Language">
    <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0 3-4.03 3-9s-1.343-9-3-9m-9 9a9 9 0 019-9"/>
    </svg>
    <span id="lang-current">
      {isEnglish ? 'English' : isTraditional ? '繁體' : '简体'}
    </span>
    <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>
  <div class="lang-dropdown" id="lang-dropdown">
    <!-- 简体中文 -->
    <a href="/" class="lang-option" data-lang="zh" style={!isTraditional && !isEnglish ? 'color: var(--accent-light);' : ''}>
      <span>简体中文</span>
      <span class="lang-sub">ZH</span>
    </a>
    <!-- 繁体中文 -->
    <a href="/tw/" class="lang-option" data-lang="tw" style={isTraditional ? 'color: var(--accent-light);' : ''}>
      <span>繁體中文</span>
      <span class="lang-sub">TW</span>
    </a>
    <!-- English -->
    <a href="/en/" class="lang-option" data-lang="en" style={isEnglish ? 'color: var(--accent-light);' : ''}>
      <span>English</span>
      <span class="lang-sub">EN</span>
    </a>
  </div>
</div>

<script>
  const switcher = document.getElementById('lang-switcher');
  const btn = document.getElementById('lang-btn');
  const dropdown = document.getElementById('lang-dropdown');

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('show');
  });

  document.addEventListener('click', () => {
    dropdown?.classList.remove('show');
  });
</script>

<style>
  .lang-switcher { position: relative; }

  .lang-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    font-family: inherit;
  }

  .lang-btn:hover {
    border-color: var(--accent);
    color: var(--text-secondary);
  }

  .lang-dropdown {
    position: absolute;
    bottom: calc(100% + 6px);
    right: 0;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 4px;
    min-width: 130px;
    display: none;
    flex-direction: column;
    gap: 1px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    z-index: 200;
  }

  .lang-dropdown.show { display: flex; }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 12px;
    border-radius: 5px;
    transition: background 0.1s;
    font-size: 13px;
    color: var(--text-primary);
    text-decoration: none;
    font-family: inherit;
    gap: 8px;
  }

  .lang-option:hover { background: rgba(255,255,255,0.05); }

  .lang-sub {
    font-size: 10px;
    color: var(--text-muted);
  }
</style>
