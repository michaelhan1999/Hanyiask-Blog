---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout
  title={`${post.data.title} — 韩正新`}
  description={post.data.description}
  pubDate={post.data.pubDate}
>
  <div class="max-w-[1120px] mx-auto px-8 sm:px-16 py-20">

    <!-- 返回 -->
    <div class="max-w-[720px] animate-fade-up">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-xs text-slate-600 hover:text-violet-400 transition-colors no-underline group mb-16"
      >
        <svg class="w-3 h-3 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        返回文章列表
      </a>
    </div>

    <!-- 文章头（正文宽度内居中） -->
    <header class="max-w-[720px] mb-12 animate-fade-up delay-100">
      {post.data.tags.length > 0 && (
        <div class="flex gap-2 mb-6">
          {post.data.tags.map(tag => (
            <span class="tag text-[10px]">{tag}</span>
          ))}
        </div>
      )}

      <h1 class="text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-tight leading-[1.15] mb-6">
        <span class="text-transparent bg-clip-text bg-gradient-to-b from-slate-100/90 to-slate-300/70">
          {post.data.title}
        </span>
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600">
        <time datetime={post.data.pubDate.toISOString()} class="font-mono">
          {formatDate(post.data.pubDate)}
        </time>
        <span class="w-1 h-1 rounded-full bg-slate-700"></span>
        <span class="text-slate-500">约 {post.data.description.length * 2} 字</span>
      </div>

      <div class="mt-10 h-px bg-gradient-to-r from-violet-600/60 via-violet-500/20 to-transparent"></div>
    </header>

    <!-- 正文（正文宽度内居中） -->
    <div class="max-w-[720px] animate-fade-up delay-200">
      <div class="prose">
        <Content />
      </div>
    </div>

    <!-- 作者卡片（正文宽度内居中） -->
    <footer class="max-w-[720px] mt-20 pt-10 border-t border-[#1a1a24] animate-fade-up delay-300">
      <div class="card p-8 flex flex-col sm:flex-row items-start gap-6">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-600/30 to-purple-700/30 border border-violet-500/20 flex items-center justify-center shrink-0">
          <span class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-violet-400 to-purple-300" style="font-family: 'Noto Serif SC', serif">韩</span>
        </div>
        <div class="flex-1">
          <p class="text-base font-semibold text-slate-200 mb-1">韩正新</p>
          <p class="text-sm text-slate-500 leading-relaxed mb-4">
            AI 产品经理。写关于技术、产品与构建东西的思考。
          </p>
          <a href="mailto:hi@hanyiask.com" class="btn text-xs">打个招呼</a>
        </div>
      </div>

      <div class="mt-10">
        <a href="/blog" class="inline-flex items-center gap-2 text-xs text-slate-600 hover:text-violet-400 transition-colors no-underline group">
          <svg class="w-3 h-3 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          返回文章列表
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
