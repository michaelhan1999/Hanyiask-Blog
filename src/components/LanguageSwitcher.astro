---
// 语言切换器组件
const languages = [
  { code: 'zh', native: '中文', label: '中文' },
  { code: 'en', native: 'English', label: 'English' },
  { code: 'ko', native: '한국어', label: '한국어' },
  { code: 'ja', native: '日本語', label: '日本語' },
];
---

<div class="lang-switcher" id="lang-switcher">
  <button class="lang-btn" id="lang-btn" aria-label="选择语言">
    <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
    </svg>
    <span id="lang-current">中文</span>
    <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>
  <div class="lang-dropdown" id="lang-dropdown">
    {languages.map(lang => (
      <button class="lang-option" data-lang={lang.code} data-label={lang.label}>
        <span>{lang.native}</span>
      </button>
    ))}
  </div>
</div>

<script define:vars={{ languages }}>
  const LANG_KEY = 'blog-lang-v2';

  const T = {
    zh: {
      nav_home: '首页', nav_blog: '文章', nav_about: '关于',
      cta_read: '阅读文章', cta_about: '关于我', cta_contact: '联系我',
      latest: '最新文章', view_all: '查看全部',
      back: '返回', back_to_list: '返回文章列表',
      author: '韩正新', author_bio: 'AI 产品经理。写关于技术、产品与构建东西的思考。',
      say_hi: '打个招呼', send_email: '发送邮件', source_code: '源代码',
      available: '开放合作 · AI 产品经理',
      total_posts: '共 {n} 篇',
      toc_title: '目录',
      section_philosophy: '理念', section_skills: '技术栈', section_projects: '代表项目', section_contact: '联系我',
      looking_forward: '期待合作', contact_desc: '欢迎聊 AI 产品想法、项目合作，或任何有意思的话题。',
      blog_meta: '关于 AI、产品与技术变现的写作',
      home_subtitle: '在 AI 与产品之间，寻找高杠杆的技术变现路径。',
      home_slogan: '世界是个草台班子，但基础设施必须坚如磐石。',
    },
    en: {
      nav_home: 'Home', nav_blog: 'Blog', nav_about: 'About',
      cta_read: 'Read Blog', cta_about: 'About Me', cta_contact: 'Contact',
      latest: 'Latest', view_all: 'View all',
      back: 'Back', back_to_list: 'All posts',
      author: 'Hanyiask', author_bio: 'AI Product Manager. Writing about technology, products, and the craft of building things.',
      say_hi: 'Say hi', send_email: 'Email', source_code: 'GitHub',
      available: 'Open to work · AI Product Manager',
      total_posts: '{n} posts',
      toc_title: 'Contents',
      section_philosophy: 'Philosophy', section_skills: 'Skills', section_projects: 'Projects', section_contact: 'Contact',
      looking_forward: 'Let\'s work together', contact_desc: 'Open to interesting AI product ideas and collaborations.',
      blog_meta: 'Writing on AI, product strategy, and engineering.',
      home_subtitle: 'Finding high-leverage paths at the intersection of AI and products.',
      home_slogan: 'The world is a improv stage — but the infra must hold.',
    },
    ko: {
      nav_home: '홈', nav_blog: '블로그', nav_about: '소개',
      cta_read: '블로그 읽기', cta_about: '소개', cta_contact: '연락',
      latest: '최신글', view_all: '전체보기',
      back: '뒤로', back_to_list: '모든 글',
      author: '한정신', author_bio: 'AI 제품 매니저. 기술, 제품, 구축에 대해 글을 씁니다.',
      say_hi: '인사하기', send_email: '이메일', source_code: 'GitHub',
      available: '협력 환영 · AI 제품 매니저',
      total_posts: '{n}개 글',
      toc_title: '목차',
      section_philosophy: '철학', section_skills: '기술 스택', section_projects: '대표 프로젝트', section_contact: '연락처',
      looking_forward: '협력 환영', contact_desc: 'AI 제품 아이디어와 프로젝트 협력 등 흥미로운 이야기 환영.',
      blog_meta: 'AI, 제품 전략, 기술에 관한 글.',
      home_subtitle: 'AI와 제품의 교차점에서 높은 레버리지 경로를 찾고 있습니다.',
      home_slogan: '세상은 즉흥 연극이지만, 인프라는 단단해야 합니다.',
    },
    ja: {
      nav_home: 'ホーム', nav_blog: 'ブログ', nav_about: '概要',
      cta_read: 'ブログを読む', cta_about: '自己紹介', cta_contact: '連絡',
      latest: '最新記事', view_all: 'すべて見る',
      back: '戻る', back_to_list: '記事一覧',
      author: '韓正新', author_bio: 'AI プロダクトマネージャー。技術、プロダクト、構築について書きます。',
      say_hi: '挨拶する', send_email: 'メール', source_code: 'GitHub',
      available: 'コラボレーション可 · AI プロダクトマネージャー',
      total_posts: '{n}件の記事',
      toc_title: '目次',
      section_philosophy: '哲学', section_skills: '技術スタック', section_projects: '代表プロジェクト', section_contact: '連絡先',
      looking_forward: 'コラボレーション', contact_desc: 'AIプロダクトのアイデアやプロジェクト協力など、面白い話はいつでも歓迎です。',
      blog_meta: 'AI、產品戦略、技術についての記事。',
      home_subtitle: 'AIとプロダクトの交差点で、高レバレッジな道を探る。',
      home_slogan: '世界は即興の舞台だが、インフラは堅固でなければならない。',
    },
  };

  const switcher = document.getElementById('lang-switcher');
  const btn = document.getElementById('lang-btn');
  const dropdown = document.getElementById('lang-dropdown');
  const currentLabel = document.getElementById('lang-current');

  function getSavedLang() {
    return localStorage.getItem(LANG_KEY) || 'zh';
  }

  function applyTranslations(lang) {
    const t = T[lang] || T.zh;
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.dataset.i18n;
      if (key && t[key]) {
        let text = t[key];
        // 支持 {n} 占位符
        const n = el.dataset.i18nN;
        if (n !== undefined) text = text.replace('{n}', n);
        el.textContent = text;
      }
    });
    document.documentElement.lang = lang;
  }

  // Initialize button label
  function updateBtnLabel(lang) {
    const langData = languages.find(l => l.code === lang);
    if (langData && currentLabel) {
      currentLabel.textContent = langData.label;
    }
  }

  // Restore saved language on load
  const savedLang = getSavedLang();
  applyTranslations(savedLang);
  updateBtnLabel(savedLang);

  // Toggle dropdown
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dropdown?.classList.toggle('show');
  });

  document.addEventListener('click', () => {
    dropdown?.classList.remove('show');
  });

  // Language option click
  dropdown?.querySelectorAll('.lang-option').forEach(opt => {
    opt.addEventListener('click', () => {
      const lang = opt.dataset.lang;
      if (!lang) return;
      localStorage.setItem(LANG_KEY, lang);
      applyTranslations(lang);
      updateBtnLabel(lang);
      dropdown?.classList.remove('show');
    });
  });
</script>

<style>
  .lang-switcher { position: relative; }

  .lang-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    font-family: inherit;
    letter-spacing: 0.01em;
  }

  .lang-btn:hover {
    border-color: var(--accent);
    color: var(--text-secondary);
  }

  .lang-dropdown {
    position: absolute;
    bottom: calc(100% + 6px);
    right: 0;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 4px;
    min-width: 120px;
    display: none;
    flex-direction: column;
    gap: 1px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    z-index: 200;
  }

  .lang-dropdown.show { display: flex; }

  .lang-option {
    display: flex;
    align-items: center;
    padding: 7px 12px;
    background: transparent;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.1s;
    font-size: 13px;
    color: var(--text-primary);
    font-family: inherit;
    text-align: left;
  }

  .lang-option:hover { background: rgba(255,255,255,0.05); }
</style>
