---
import '../styles/global.css';
import SplashScreen from '../components/SplashScreen.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import VisitorCounter from '../components/VisitorCounter.astro';
import HomeIcon from '../components/icons/HomeIcon.astro';
import BlogIcon from '../components/icons/BlogIcon.astro';
import AboutIcon from '../components/icons/AboutIcon.astro';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  showSplash?: boolean;
  lang?: 'zh' | 'tw' | 'en';
}

const {
  title,
  description = 'AI 产品经理 | 探索高杠杆的技术变现',
  pubDate,
  showSplash = false,
  lang = 'zh',
} = Astro.props;

const isTw = lang === 'tw';
const isEn = lang === 'en';
const base = isTw ? '/tw' : isEn ? '/en' : '';

const navLinks = [
  { href: `${base}/`, label: isEn ? 'Home' : isTw ? '首頁' : '首页', icon: 'home' },
  { href: `${base}/blog`, label: isEn ? 'Blog' : isTw ? '文章' : '文章', icon: 'blog' },
  { href: `${base}/about`, label: isEn ? 'About' : isTw ? '關於' : '关于', icon: 'about' },
  { href: 'https://github.com/michaelhan1999', label: 'Agent', icon: 'github', external: true },
  { href: `${base}/blog/ai-pm-skills`, label: isEn ? 'Tools' : isTw ? '工具' : '工具', icon: 'download' },
];

const pathname = Astro.url.pathname;

function isActive(href: string) {
  const fullHref = href.startsWith('http') ? href : `${base}${href}`;
  if (href === '/') return pathname === `${base}/`;
  return pathname.startsWith(`${base}${href}`);
}
---

<!doctype html>
<html lang={isTw ? 'zh-TW' : isEn ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content={pubDate ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    {showSplash && <SplashScreen lang={lang} />}
    <div id="progress-bar"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-logo">韩</div>
        <div>
          <div class="sidebar-brand-name">韩正新</div>
          <div class="sidebar-brand-title">{isEn ? 'AI Product Manager' : isTw ? 'AI 產品經理' : 'AI 产品经理'}</div>
        </div>
      </div>

      <nav class="sidebar-nav">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[{ active: isActive(link.href) }]}
          >
            {link.icon === 'home' && <HomeIcon />}
            {link.icon === 'blog' && <BlogIcon />}
            {link.icon === 'about' && <AboutIcon />}
            <span>{link.label}</span>
          </a>
        ))}
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-footer-top">
          <VisitorCounter />
          <LanguageSwitcher />
        </div>
        <a href="mailto:hi@hanyiask.com" class="sidebar-footer-link">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {isEn ? 'Email' : isTw ? '傳送郵件' : '发送邮件'}
        </a>
        <a href="https://github.com" target="_blank" rel="noopener" class="sidebar-footer-link">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          {isEn ? 'Source Code' : isTw ? '原始碼' : '源代码'}
        </a>
      </div>
    </aside>

    <!-- Mobile Header -->
    <header class="mobile-header">
      <div class="sidebar-brand" style="padding: 0; border: none;">
        <div class="sidebar-brand-logo" style="width:30px;height:30px;font-size:13px;">韩</div>
        <div>
          <div class="sidebar-brand-name" style="font-size:12px;">韩正新</div>
        </div>
      </div>
      <button class="mobile-menu-btn" id="menu-toggle" aria-label={isEn ? 'Menu' : isTw ? '選單' : '菜单'}>
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="mobile-overlay" id="overlay"></div>

    <main class="main-content">
      <slot />
    </main>

    <script>
      const progressBar = document.getElementById('progress-bar');
      if (progressBar) {
        window.addEventListener('scroll', () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? scrollTop / docHeight : 0;
          progressBar.style.transform = `scaleX(${progress})`;
        }, { passive: true });
      }

      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');

      function openMenu() {
        sidebar?.classList.add('open');
        overlay?.classList.add('show');
        document.body.style.overflow = 'hidden';
      }
      function closeMenu() {
        sidebar?.classList.remove('open');
        overlay?.classList.remove('show');
        document.body.style.overflow = '';
      }

      menuToggle?.addEventListener('click', openMenu);
      overlay?.addEventListener('click', closeMenu);
      sidebar?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    </script>
  </body>
</html>
