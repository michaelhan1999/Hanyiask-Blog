---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于 — 韩正新" description="AI 产品经理，探索技术与产品的交汇处。">

  <!-- 返回 -->
  <div class="w-full pt-24 pb-0 px-8 sm:px-16">
    <div class="max-w-[1120px] mx-auto">
      <a href="/" class="inline-flex items-center gap-2 text-xs text-slate-600 hover:text-violet-400 transition-colors no-underline group animate-fade-up mb-0">
        <svg class="w-3 h-3 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        返回首页
      </a>
    </div>
  </div>

  <!-- 头部 -->
  <div class="w-full pt-16 pb-12 px-8 sm:px-16">
    <div class="max-w-[1120px] mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-10 items-start animate-fade-up delay-100">
        <!-- 头像 -->
        <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-violet-600/40 to-purple-700/40 border border-violet-500/20 flex items-center justify-center shadow-[0_0_40px_rgba(139,92,246,0.1)]">
          <span class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-violet-300 to-purple-200" style="font-family: 'Noto Serif SC', serif">韩</span>
        </div>

        <!-- 信息 -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <h1 class="text-3xl font-bold text-slate-100 tracking-tight">韩正新</h1>
            <span class="text-xs text-violet-400 border border-violet-500/30 px-2 py-0.5 rounded-full">AI PM</span>
          </div>
          <p class="text-base text-slate-400 leading-loose max-w-[600px]">
            在人工智能与产品之间，寻找高杠杆的技术变现路径。
            把 AI 能力翻译成用户愿意付费的产品，是我的日常工作。
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="h-px bg-[#1a1a24] mx-8 sm:mx-16 max-w-[1120px] mx-auto" style="margin-left: auto; margin-right: auto;"></div>
  <div style="height: 1px; background: #1a1a24; margin: 0 2rem;"></div>

  <!-- 理念 -->
  <section class="w-full pt-16 pb-0 px-8 sm:px-16">
    <div class="max-w-[1120px] mx-auto max-w-[720px]" style="max-width: 720px; margin: 0 auto;">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-6 h-px bg-violet-500/60"></div>
        <span class="text-[11px] tracking-[0.2em] uppercase text-slate-600">理念</span>
      </div>
      <div class="card p-10 border-l-2 border-l-violet-500 animate-fade-up delay-200">
        <p class="text-[clamp(1rem,2vw,1.2rem)] text-slate-300 leading-relaxed font-light">
          "世界是个草台班子，所有人都在即兴发挥，直到他们成功。
          <br class="hidden sm:block" />
          但当别人还在临场发挥的时候，我在搭建不会崩溃的系统。"
        </p>
      </div>
    </div>
  </section>

  <!-- 技能 -->
  <section class="w-full pt-16 px-8 sm:px-16">
    <div class="max-w-[1120px] mx-auto" style="max-width: 720px; margin: 0 auto;">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-6 h-px bg-violet-500/60"></div>
        <span class="text-[11px] tracking-[0.2em] uppercase text-slate-600">技术栈</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-fade-up delay-300">
        {[
          { cat: 'AI / 机器学习', items: ['LLM 与 Prompt 工程', 'RAG 系统', '模型微调', 'AI 产品策略'] },
          { cat: '产品能力', items: ['PRD 与路线图', '用户研究', '数据驱动决策', 'GTM 策略'] },
          { cat: '工程技能', items: ['TypeScript / Python', 'Cloudflare Workers', 'Docker 与 CI/CD', 'PostgreSQL'] },
        ].map(group => (
          <div class="card p-6">
            <p class="text-xs font-semibold text-violet-400 mb-4 tracking-wide">{group.cat}</p>
            <ul class="space-y-2.5">
              {group.items.map(item => (
                <li class="text-sm text-slate-500 leading-relaxed flex items-start gap-2">
                  <span class="w-1 h-1 rounded-full bg-violet-500/40 mt-2 shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 项目 -->
  <section class="w-full pt-16 px-8 sm:px-16">
    <div class="max-w-[1120px] mx-auto" style="max-width: 720px; margin: 0 auto;">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-6 h-px bg-violet-500/60"></div>
        <span class="text-[11px] tracking-[0.2em] uppercase text-slate-600">代表项目</span>
      </div>
      <div class="space-y-4 animate-fade-up delay-400">
        <div class="card p-8">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-base font-semibold text-slate-200">韩正新博客</h3>
            <span class="tag text-[10px]">2026</span>
          </div>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">
            这个网站。零成本、极速加载，基于 Astro + TailwindCSS，部署在 Cloudflare Pages。
            极简紫黑主题，展示 AI 产品经理的技术思考。
          </p>
          <div class="flex gap-2 flex-wrap">
            {['Astro', 'TailwindCSS', 'Cloudflare Pages'].map(t => (
              <span class="text-[10px] text-slate-600 border border-[#1a1a24] px-2 py-0.5 rounded">{t}</span>
            ))}
          </div>
        </div>
        <div class="card p-8">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-base font-semibold text-slate-200">ContentSafe 内容保险箱</h3>
            <span class="tag text-[10px]">2025</span>
          </div>
          <p class="text-sm text-slate-500 leading-relaxed mb-5">
            Android 离线阅读应用，支持头条、微信公众号、微博、知乎等内容平台的文章保存与分类管理。
            使用 Kotlin + Jetpack Compose 构建。
          </p>
          <div class="flex gap-2 flex-wrap">
            {['Kotlin', 'Jetpack Compose', 'Room', 'OkHttp'].map(t => (
              <span class="text-[10px] text-slate-600 border border-[#1a1a24] px-2 py-0.5 rounded">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 联系方式 -->
  <section class="w-full pt-16 pb-24 px-8 sm:px-16">
    <div class="max-w-[1120px] mx-auto" style="max-width: 720px; margin: 0 auto;">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-6 h-px bg-violet-500/60"></div>
        <span class="text-[11px] tracking-[0.2em] uppercase text-slate-600">联系我</span>
      </div>
      <div class="card p-10 flex flex-col sm:flex-row items-start sm:items-center gap-6 animate-fade-up delay-500">
        <div class="flex-1">
          <p class="text-base text-slate-200 mb-1">期待合作</p>
          <p class="text-sm text-slate-600">欢迎聊 AI 产品想法、项目合作，或任何有意思的话题。</p>
        </div>
        <a href="mailto:hi@hanyiask.com" class="btn btn-primary text-sm shrink-0">
          hi@hanyiask.com
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
